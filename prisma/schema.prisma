// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Users {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  validated Boolean  @default(true)
  createdAt DateTime @default(now())
  perfilId  Int      @default(1)
  informes  Informes[]
  notasTecnico NotasDelTecnico[]
  auditoria Auditoria[]
  diagnosisCreated Diagnosis[] @relation("DiagnosisCreatedBy")
  perfil    Perfiles @relation(fields: [perfilId], references: [id])
}

model Perfiles {
  id    Int     @id
  tipo  String  @unique
  users Users[]
  functions PerfilesFunctions[]
}


model Patients {
  dni        String   @id @default(uuid())
  nombre      String
  apellido    String
  age       Int
  email     String   @unique
  telefono String?
  createdAt DateTime @default(now())
  diagnoses  Diagnosis[]
}

model Doctors {
  id        String   @id @default(uuid())
  nombre      String
  apellido    String
  specialty   String
  email     String   @unique
  createdAt DateTime @default(now())
}

model Diagnosis {
  id                      String   @id @default(uuid())
  sampleCode              String?  @unique
  patientId               String
  userId                  String?
  diagnosis               String
  material                String
  profesionalSolicitante String
  biopsasPrevias          Boolean
  estudioPrevioFecha      DateTime?
  createdAt               DateTime @default(now())
  eliminado               Boolean  @default(false)

  patient                 Patients  @relation(fields: [patientId], references: [dni])
  creator                 Users?    @relation("DiagnosisCreatedBy", fields: [userId], references: [id])
  informe                 Informes?
  notasTecnico            NotasDelTecnico?
  auditoria               Auditoria[]
}

model DiagnosisSequence {
  year      Int
  month     Int
  lastValue Int @default(0)

  @@id([year, month])
}

model Informes {
  id          String    @id @default(uuid())
  cuerpo      String
  diagnosisId String    @unique
  userId      String
  createdAt   DateTime  @default(now())
  eliminado   Boolean   @default(false)

  diagnosis   Diagnosis @relation(fields: [diagnosisId], references: [id])
  user        Users     @relation(fields: [userId], references: [id])
  sharedLinks SharedReportLink[]
}

model SharedReportLink {
  id         String   @id @default(uuid())
  token      String   @unique
  password   String
  informeId  String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  informe    Informes @relation(fields: [informeId], references: [id])
}

model Functions {
  id       Int                 @id @default(autoincrement())
  name     String
  perfiles PerfilesFunctions[]
}

model PerfilesFunctions {
  perfil_id  Int
  function_id Int
  
  // Relations
  perfil  Perfiles  @relation(fields: [perfil_id], references: [id], onDelete: Cascade)
  function Functions @relation(fields: [function_id], references: [id], onDelete: Cascade)

  // The composite primary key object directive
  @@id([perfil_id, function_id])
}

model SeedLog {
  id        Int      @id @default(autoincrement())
  status    String   // "success" o "error"
  message   String?
  executedAt DateTime @default(now())
}

model NotasDelTecnico {
  id          String   @id @default(uuid())
  diagnosisId String   @unique
  createdAt   DateTime @default(now())
  cuerpo      String
  imagenes    String[] @default([])
  userId      String
  eliminado   Boolean  @default(false)

  diagnosis   Diagnosis @relation(fields: [diagnosisId], references: [id])
  user        Users     @relation(fields: [userId], references: [id])
}

model Auditoria {
  id          String   @id @default(uuid())
  userId      String
  diagnosisId String
  createdAt   DateTime @default(now())

  user        Users     @relation(fields: [userId], references: [id])
  diagnosis   Diagnosis @relation(fields: [diagnosisId], references: [id])
}